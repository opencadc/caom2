<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE web-app PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.2//EN" "http://java.sun.com/j2ee/dtds/web-app_2_2.dtd">
<web-app>
    <display-name>sc2soda</display-name>
    
    <servlet>
        <load-on-startup>1</load-on-startup>
        <servlet-name>logControl</servlet-name>
        <servlet-class>ca.nrc.cadc.log.LogControlServlet</servlet-class>
        <init-param>
            <param-name>logLevel</param-name>
            <param-value>info</param-value>
        </init-param>
        <init-param>
            <param-name>logLevelPackages</param-name>
            <param-value>
                ca.nrc.cadc.sc2soda
                ca.nrc.cadc.caom2ops
                ca.nrc.cadc.caom2.soda
                ca.nrc.cadc.caom2.compute
                ca.nrc.cadc.dali
                ca.nrc.cadc.vosi
                ca.nrc.cadc.uws
                ca.nrc.cadc.wcs
            </param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet>
        <servlet-name>CapabilitiesServlet</servlet-name>
        <servlet-class>ca.nrc.cadc.rest.RestServlet</servlet-class>
        <init-param>
            <param-name>init</param-name>
            <param-value>ca.nrc.cadc.vosi.CapInitAction</param-value>
        </init-param>
        <init-param>
            <param-name>head</param-name>
            <param-value>ca.nrc.cadc.vosi.CapHeadAction</param-value>
        </init-param>
        <init-param>
            <param-name>get</param-name>
            <param-value>ca.nrc.cadc.vosi.CapGetAction</param-value>
        </init-param>
        <init-param>
            <param-name>input</param-name>
            <param-value>/capabilities.xml</param-value>
        </init-param>
        <load-on-startup>3</load-on-startup>
    </servlet>

    <servlet>
        <load-on-startup>3</load-on-startup>
        <servlet-name>AvailabilityServlet</servlet-name>
        <servlet-class>ca.nrc.cadc.vosi.AvailabilityServlet</servlet-class>
        <init-param>
            <description>
            </description>
            <param-name>ca.nrc.cadc.vosi.AvailabilityPlugin</param-name>
            <param-value>ca.nrc.cadc.sc2soda.ServiceAvailabilityImpl</param-value>
        </init-param>
    </servlet>
    
    <servlet>
        <load-on-startup>2</load-on-startup>
        <servlet-name>SyncSodaServlet</servlet-name>
        <servlet-class>ca.nrc.cadc.uws.server.JobServlet</servlet-class>
        <init-param>
            <param-name>get</param-name>
            <param-value>ca.nrc.cadc.uws.web.SyncGetAction</param-value>
        </init-param>
        <init-param>
            <param-name>post</param-name>
            <param-value>ca.nrc.cadc.uws.web.SyncPostAction</param-value>
        </init-param>
        <init-param>
            <param-name>ca.nrc.cadc.uws.server.JobManager</param-name>
            <param-value>ca.nrc.cadc.sc2soda.MyJobManager</param-value>
        </init-param>
    </servlet>
    
    <servlet>
        <servlet-name>AsyncSodaServlet</servlet-name>
        <servlet-class>ca.nrc.cadc.uws.server.AsyncServlet</servlet-class>
        <init-param>
            <param-name>get</param-name>
            <param-value>ca.nrc.cadc.uws.web.GetAction</param-value>
        </init-param>
        <init-param>
            <param-name>post</param-name>
            <param-value>ca.nrc.cadc.uws.web.PostAction</param-value>
        </init-param>
        <init-param>
            <param-name>delete</param-name>
            <param-value>ca.nrc.cadc.uws.web.DeleteAction</param-value>
        </init-param>
        
        <init-param>
            <param-name>ca.nrc.cadc.uws.server.JobManager</param-name>
            <param-value>ca.nrc.cadc.sc2soda.MyJobManager</param-value>
        </init-param>
        <load-on-startup>2</load-on-startup>
    </servlet>
    <servlet>
        <load-on-startup>2</load-on-startup>
        <servlet-name>SodaEchoServlet</servlet-name>
        <servlet-class>ca.nrc.cadc.rest.RestServlet</servlet-class>
        <init-param>
            <param-name>get</param-name>
            <param-value>ca.nrc.cadc.sc2soda.EchoAction</param-value>
        </init-param>
    </servlet>

    <!-- URL-to-servlet mapping -->
    
    <servlet-mapping>
        <servlet-name>logControl</servlet-name>
        <url-pattern>/logControl</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>AvailabilityServlet</servlet-name>
        <url-pattern>/availability</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>CapabilitiesServlet</servlet-name>
        <url-pattern>/capabilities</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>SyncSodaServlet</servlet-name>
        <url-pattern>/sync</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>AsyncSodaServlet</servlet-name>
        <url-pattern>/async</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>SyncSodaServlet</servlet-name>
        <url-pattern>/auth-sync</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>AsyncSodaServlet</servlet-name>
        <url-pattern>/auth-async</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>SodaEchoServlet</servlet-name>
        <url-pattern>/soda-echo/*</url-pattern>
    </servlet-mapping>
    
    <!-- security constraints -->
    
    <security-role>
        <description>Public security role</description>
        <role-name>public</role-name>
    </security-role>

    <security-constraint>
        <web-resource-collection>
            <web-resource-name>auth</web-resource-name>
            <description/>
            <url-pattern>/auth-sync/*</url-pattern>
            <url-pattern>/auth-async/*</url-pattern>
            <url-pattern>/logControl/*</url-pattern>
            <http-method>GET</http-method>
            <http-method>POST</http-method>
            <http-method>HEAD</http-method>
            <http-method>PUT</http-method>
            <http-method>OPTIONS</http-method>
            <http-method>TRACE</http-method>
            <http-method>DELETE</http-method>
        </web-resource-collection>
        <auth-constraint>
            <description>force authentication for all requests</description>
            <role-name>public</role-name>
        </auth-constraint>
    </security-constraint>
    
    <login-config>
        <auth-method>BASIC</auth-method>
        <realm-name>Canadian Astronomy Data Centre</realm-name>
    </login-config>
</web-app>
